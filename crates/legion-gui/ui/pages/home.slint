import { Palette, Metrics, Card, StatRow } from "../theme.slint";

// Profile selector plus the live readings. This is the page the tray opens to.
export component HomePage inherits VerticalLayout {
    in property <[string]> profile-choices;
    in property <[string]> profile-labels;
    in property <string> current-profile;
    in property <brush> profile-color;
    in property <bool> profile-supported;

    in property <string> cpu-temp;
    in property <string> cpu-freq;
    in property <string> cpu-governor;
    in property <string> fan-rpm;
    in property <string> battery-capacity;
    in property <string> battery-status;
    in property <string> ac-state;

    callback select-profile(string);

    spacing: Metrics.gap;

    Card {
        title: "Power Mode";

        if !profile-supported: Text {
            text: "No platform-profile device found — is lenovo-wmi-gamezone loaded?";
            color: Palette.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        if profile-supported: VerticalLayout {
            spacing: 8px;

            for choice[i] in root.profile-choices: TouchArea {
                height: 44px;
                clicked => { root.select-profile(choice); }

                Rectangle {
                    border-radius: Metrics.radius;
                    background: choice == root.current-profile
                        ? Palette.accent-dim
                        : (parent.has-hover ? Palette.surface-alt : transparent);
                    border-width: 1px;
                    border-color: choice == root.current-profile ? Palette.accent : Palette.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        // The power-button LED colour for this mode.
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            y: (parent.height - self.height) / 2;
                            background: choice == root.current-profile
                                ? root.profile-color
                                : Palette.text-dim;
                        }

                        Text {
                            text: i < root.profile-labels.length ? root.profile-labels[i] : choice;
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: choice == root.current-profile ? 700 : 400;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if choice == root.current-profile: Text {
                            text: "active";
                            color: Palette.text-dim;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Metrics.gap;

        Card {
            title: "Processor";
            horizontal-stretch: 1;
            StatRow { label: "Temperature"; value: root.cpu-temp; }
            StatRow { label: "Frequency"; value: root.cpu-freq; }
            StatRow { label: "Governor"; value: root.cpu-governor; }
            StatRow { label: "Fan"; value: root.fan-rpm; }
        }

        Card {
            title: "Battery";
            horizontal-stretch: 1;
            StatRow { label: "Charge"; value: root.battery-capacity; }
            StatRow { label: "State"; value: root.battery-status; }
            StatRow { label: "Adapter"; value: root.ac-state; }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
