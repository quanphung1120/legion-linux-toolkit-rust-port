import { Palette, Metrics, Card, StatRow } from "../theme.slint";

export component BatteryPage inherits VerticalLayout {
    in property <bool> supported;
    in property <string> mode;              // kernel token: Standard/Fast/Long_Life
    in property <[string]> mode-choices;
    in property <[string]> mode-labels;
    in property <[string]> mode-hints;

    in property <string> capacity;
    in property <string> status;
    in property <string> health;
    in property <string> cycles;
    in property <string> power-draw;
    in property <string> voltage;
    in property <string> ac-state;

    callback select-mode(string);

    spacing: Metrics.gap;

    Card {
        title: "Charging Mode";

        if !supported: Text {
            text: "This kernel does not expose charge_types for BAT0.";
            color: Palette.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        if supported: VerticalLayout {
            spacing: 8px;

            for choice[i] in root.mode-choices: TouchArea {
                height: 52px;
                clicked => { root.select-mode(choice); }

                Rectangle {
                    border-radius: Metrics.radius;
                    background: choice == root.mode
                        ? Palette.accent-dim
                        : (parent.has-hover ? Palette.surface-alt : transparent);
                    border-width: 1px;
                    border-color: choice == root.mode ? Palette.accent : Palette.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            y: (parent.height - self.height) / 2;
                            border-width: 2px;
                            border-color: choice == root.mode ? Palette.accent : Palette.border;
                            background: choice == root.mode ? Palette.accent : transparent;
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: i < root.mode-labels.length ? root.mode-labels[i] : choice;
                                color: Palette.text;
                                font-size: 14px;
                            }
                            if i < root.mode-hints.length: Text {
                                text: root.mode-hints[i];
                                color: Palette.text-dim;
                                font-size: 11px;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }

    Card {
        title: "Status";
        StatRow { label: "Charge"; value: root.capacity; }
        StatRow { label: "State"; value: root.status; }
        StatRow { label: "Adapter"; value: root.ac-state; }
        StatRow { label: "Health"; value: root.health; }
        StatRow { label: "Cycles"; value: root.cycles; }
        StatRow { label: "Draw"; value: root.power-draw; }
        StatRow { label: "Voltage"; value: root.voltage; }
    }

    Rectangle { vertical-stretch: 1; }
}
